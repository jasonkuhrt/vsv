{
  "name": "@jasonkuhrt/vsv",
  "version": "0.1.1",
  "keywords": [
    "bun",
    "effect",
    "extension",
    "sdk",
    "voidzero",
    "vscode"
  ],
  "license": "MIT",
  "author": {
    "name": "Jason Kuhrt",
    "url": "https://kuhrt.me"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jasonkuhrt/vsv.git"
  },
  "bin": {
    "vsv": "./build/exports/cli.js"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "COLDSTART.md"
  ],
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./build/exports/index.js",
    "./builtins": "./build/exports/builtins.js",
    "./manifest": "./build/exports/manifest.js",
    "./runtime": "./build/exports/runtime.js",
    "./schema": "./build/exports/schema.js",
    "./when": "./build/exports/when.js",
    "./runtime/test": "./build/exports/runtime-test.js",
    "./cli": "./build/exports/cli.js",
    "./runtime/vscode": "./build/exports/runtime-vscode.js"
  },
  "scripts": {
    "build": "tsrs --build tsconfig.build.json && bun run build:rewrite-imports",
    "build:clean": "tsrs --build --clean tsconfig.build.json && rm -rf build",
    "build:rewrite-imports": "bun scripts/rewrite-lib-imports.ts",
    "build:watch": "tsrs --build tsconfig.build.json --watch",
    "check": "bun run check:format && bun run check:lint && bun run check:purity && bun run check:types && bun run check:types-d && bun run test && bun run build && bun run check:package && bun run check:exports",
    "check:exports": "attw --pack . --profile esm-only",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --type-aware --deny-warnings",
    "check:package": "publint run --strict",
    "check:purity": "bun scripts/check-purity.ts",
    "check:types": "tsrs --noEmit --fast",
    "check:types-d": "vitest run --typecheck --typecheck.only --typecheck.checker tsrs --typecheck.tsconfig ./tsconfig.json",
    "fix": "bun run fix:format && bun run fix:lint",
    "fix:format": "oxfmt --write",
    "fix:lint": "oxlint --type-aware --fix-dangerously --deny-warnings",
    "postinstall": "effect-tsgo patch --typescript=false --tsrs",
    "prebuild": "bun run build:clean",
    "prepack": "bun run build",
    "test": "bun test src tests",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage src tests"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@effect/tsgo": "0.67.5",
    "@jasonkuhrt/config-presets": "0.1.0",
    "@types/bun": "1.4.4",
    "@types/node": "^25.3.5",
    "@types/vscode": "^1.100.0",
    "fast-check": "3.23.2",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "publint": "^0.3.18",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsx": "^4.19.2",
    "vitest": "^4.1.6"
  }
}
