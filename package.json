{
  "name": "@jasonkuhrt/vsv",
  "version": "0.0.0",
  "keywords": [
    "bun",
    "effect",
    "extension",
    "sdk",
    "voidzero",
    "vscode"
  ],
  "license": "MIT",
  "author": {
    "name": "Jason Kuhrt",
    "url": "https://kuhrt.me"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jasonkuhrt/vsv.git"
  },
  "bin": {
    "vsv": "./build/exports/cli.js"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "COLDSTART.md"
  ],
  "type": "module",
  "sideEffects": [
    "./build/exports/runtime-test.js",
    "./build/lib/runtime-test/install-mock.js",
    "./build/lib/runtime-test/preload.js",
    "./src/exports/runtime-test.ts",
    "./src/lib/runtime-test/install-mock.ts",
    "./src/lib/runtime-test/preload.ts"
  ],
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./build/exports/index.js",
    "./builtins": "./build/exports/builtins.js",
    "./manifest": "./build/exports/manifest.js",
    "./runtime": "./build/exports/runtime.js",
    "./schema": "./build/exports/schema.js",
    "./when": "./build/exports/when.js",
    "./runtime/test": "./build/exports/runtime-test.js",
    "./runtime/test/preload": "./build/exports/runtime-test-preload.js",
    "./cli": "./build/exports/cli.js"
  },
  "scripts": {
    "build": "tsgo --build tsconfig.build.json && bun run build:rewrite-imports",
    "build:rewrite-imports": "bun scripts/rewrite-lib-imports.ts",
    "build:clean": "tsgo --build --clean && rm -rf build",
    "prebuild": "bun run build:clean",
    "build:watch": "tsgo --build tsconfig.build.json --watch",
    "test": "bun test src tests",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage src tests",
    "fix": "bun run fix:format && bun run fix:lint",
    "fix:format": "oxfmt --write",
    "fix:lint": "oxlint --type-aware --fix-dangerously --deny-warnings",
    "check": "bun run check:format && bun run check:lint && bun run check:purity && bun run check:types && bun run check:types-d && bun run test && bun run check:package && bun run check:exports",
    "check:format": "oxfmt --check",
    "check:purity": "bun scripts/check-purity.ts",
    "check:lint": "oxlint --type-aware --deny-warnings",
    "check:types": "tsgo",
    "check:types-d": "vitest run --typecheck",
    "check:package": "publint run --strict",
    "check:exports": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "effect": "^3.19.19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "@types/vscode": "^1.100.0",
    "@typescript/native-preview": "7.0.0-dev.20260306.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "publint": "^0.3.18",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.6"
  }
}
