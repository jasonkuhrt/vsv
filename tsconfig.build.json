{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "node_modules/.cache/build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.test-d.*",
    "src/lib/runtime-test/test-effect.ts"
  ]
}
